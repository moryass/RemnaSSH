<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Common Ground Workshop — practical objects for home and work.">
  <title>Common Ground Workshop</title>
  <style>
    :root{color-scheme:light;--cream:#f1eadc;--green:#163d2c;--orange:#d85c35;--line:#b9ad98}
    *{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--green);font:16px/1.5 Arial,Helvetica,sans-serif}a{color:inherit;text-decoration:none}
    header,main,footer{width:min(1120px,calc(100% - 40px));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--line)}
    .mark{font-weight:800;letter-spacing:.04em;text-transform:uppercase}.mark span{color:var(--orange)}nav{display:flex;gap:26px;font-size:.88rem}
    .hero{display:grid;grid-template-columns:1.15fr .85fr;min-height:600px;padding:70px 0;border-bottom:1px solid var(--line)}.hero-copy{display:flex;flex-direction:column;justify-content:space-between;padding-right:60px}
    h1{margin:0;font-size:clamp(3.6rem,8vw,7.6rem);line-height:.88;letter-spacing:-.065em}.hero p{max-width:520px;margin:40px 0 0;font-size:1.15rem}
    .visual{position:relative;min-height:420px;overflow:hidden;background:var(--green)}.visual:before{content:"";position:absolute;width:68%;aspect-ratio:1;left:16%;top:16%;border:28px solid var(--cream);border-radius:50%}.visual:after{content:"";position:absolute;width:44%;height:65%;left:28%;bottom:-18%;background:var(--orange);border-radius:48% 48% 0 0}
    .stamp{font-size:.75rem;letter-spacing:.13em;text-transform:uppercase}.items{padding:72px 0}.items-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:30px}.items h2{margin:0;font-size:2rem;letter-spacing:-.04em}.items-head p{margin:0;color:#52705f}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.item{min-height:250px;padding:24px;border:1px solid var(--line);display:flex;flex-direction:column;justify-content:space-between}.item b{font-size:1.35rem}.item span{font-size:.85rem;color:#52705f}
    footer{display:flex;justify-content:space-between;padding:28px 0 42px;border-top:1px solid var(--line);font-size:.8rem;color:#52705f}
    @media(max-width:760px){.hero{grid-template-columns:1fr;gap:48px;min-height:0}.hero-copy{padding-right:0}.visual{min-height:360px}.grid{grid-template-columns:1fr}.item{min-height:180px}.items-head{display:block}.items-head p{margin-top:8px}nav{display:none}footer{display:block}footer span{display:block;margin-top:8px}}
  </style>
</head>
<body>
  <header><a class="mark" href="/">Common Ground<span>.</span></a><nav><a href="#collection">Collection</a><a href="#about">About</a><a href="mailto:workshop@__DOMAIN__">Write to us</a></nav></header>
  <main>
    <section class="hero"><div class="hero-copy"><div><h1>Objects for slower days.</h1><p>Small-batch pieces for reading, cooking and working. Designed simply, made locally and intended to age well.</p></div><div class="stamp">Workshop collection · No. 04</div></div><div class="visual" aria-hidden="true"></div></section>
    <section class="items" id="collection"><div class="items-head"><h2>Current collection</h2><p>Made in limited weekly runs</p></div><div class="grid">
      <article class="item"><span>Oak / natural oil</span><b>Reading Rest</b><span>A compact stand for books and tablets.</span></article>
      <article class="item"><span>Stoneware / matte glaze</span><b>Daily Cup</b><span>A balanced cup for coffee, tea and water.</span></article>
      <article class="item"><span>Linen / cotton</span><b>Work Cloth</b><span>A durable cloth for the kitchen or studio.</span></article>
    </div></section>
    <section class="items" id="about"><div class="items-head"><h2>Made with restraint</h2><p>Useful forms, honest materials, repairable construction.</p></div></section>
  </main>
  <footer><span>Common Ground Workshop · 2026</span><span>__DOMAIN__</span></footer>
</body>
</html>
