<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Alder & Finch provides accounting, payroll and practical business advice.">
  <title>Alder &amp; Finch Accountants</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <style>
    :root{color-scheme:light;--navy:#193047;--gold:#b7832f;--paper:#f7f7f5;--line:#dcdedc;--muted:#62707b}
    *{box-sizing:border-box}body{margin:0;background:#fff;color:var(--navy);font:16px/1.55 Arial,Helvetica,sans-serif}a{color:inherit;text-decoration:none}.wrap{width:min(1100px,calc(100% - 40px));margin:auto}
    header{border-bottom:1px solid var(--line)}.header{height:76px;display:flex;align-items:center;justify-content:space-between}.brand{font:700 1.18rem Georgia,serif}.brand span{color:var(--gold)}nav{display:flex;gap:27px;font-size:.9rem}nav a:hover{color:var(--gold)}
    .hero{padding:78px 0 70px}.hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:90px;align-items:center}.eyebrow{color:var(--gold);font-size:.75rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}h1{margin:14px 0 22px;font:700 clamp(2.6rem,5.5vw,4.7rem)/1.05 Georgia,serif;letter-spacing:-.025em}.hero p{max-width:650px;color:var(--muted);font-size:1.12rem}.cta{display:inline-block;margin-top:13px;padding:12px 19px;border-radius:4px;background:var(--navy);color:#fff;font-weight:700}
    .callout{padding:28px;border-left:4px solid var(--gold);background:var(--paper)}.callout h2{margin:0 0 12px;font-size:1.15rem}.callout p{margin:0 0 15px!important;font-size:.92rem!important}.callout a{color:var(--gold);font-weight:700}
    .services{padding:64px 0;background:var(--paper);border:1px solid var(--line);border-width:1px 0}.section-title{max-width:650px;margin-bottom:32px}.section-title h2{margin:0 0 9px;font:700 2rem Georgia,serif}.section-title p{margin:0;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.service{padding:25px;background:#fff;border:1px solid var(--line)}.service h3{margin:0 0 8px;font-size:1rem}.service p{margin:0;color:var(--muted);font-size:.91rem}
    .about{display:grid;grid-template-columns:.72fr 1.28fr;gap:70px;padding:66px 0}.about h2{margin:0;font:700 1.9rem Georgia,serif}.about p{margin:0 0 15px;color:var(--muted)}.details{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:26px}.details div{padding-top:13px;border-top:1px solid var(--line)}.details b{display:block;margin-bottom:4px}.details span{color:var(--muted);font-size:.9rem}
    footer{padding:28px 0;background:var(--navy);color:#cfdae3;font-size:.82rem}.footer{display:flex;justify-content:space-between}.footer strong{color:#fff}
    @media(max-width:760px){.header{height:64px}nav a:not(:last-child){display:none}.hero-grid,.about{grid-template-columns:1fr;gap:36px}.hero{padding:52px 0}.grid,.details{grid-template-columns:1fr}.services{padding:48px 0}.footer{display:block}.footer span{display:block;margin-top:7px}}
  </style>
</head>
<body>
  <header><div class="wrap header"><a class="brand" href="/">Alder <span>&amp;</span> Finch</a><nav><a href="#services">Services</a><a href="#about">About</a><a href="mailto:office@__DOMAIN__">Contact</a></nav></div></header>
  <main>
    <section class="wrap hero"><div class="hero-grid"><div><div class="eyebrow">Accountancy and business support</div><h1>Clear numbers. Practical advice.</h1><p>We support owner-managed businesses and independent professionals with accounts, payroll, tax planning and everyday financial decisions.</p><a class="cta" href="mailto:office@__DOMAIN__">Arrange an introductory call</a></div><aside class="callout"><h2>Existing client?</h2><p>Send documents or a question to the team using your usual secure channel.</p><a href="mailto:office@__DOMAIN__">Contact the office →</a></aside></div></section>
    <section class="services" id="services"><div class="wrap"><div class="section-title"><h2>Support that fits your business</h2><p>Regular, dependable work alongside advice when plans or circumstances change.</p></div><div class="grid"><article class="service"><h3>Annual accounts and tax</h3><p>Timely preparation, clear explanations and practical planning before deadlines.</p></article><article class="service"><h3>Bookkeeping and reporting</h3><p>Accurate records and useful monthly or quarterly information for decisions.</p></article><article class="service"><h3>Payroll</h3><p>Routine payroll administration, employee changes and year-end requirements.</p></article><article class="service"><h3>Business planning</h3><p>Cash-flow forecasts, budgeting and an independent view of important choices.</p></article></div></div></section>
    <section class="wrap about" id="about"><h2>A straightforward working relationship</h2><div><p>Our work is organised around reliable deadlines, accessible advice and a clear understanding of how each client operates. We keep communication direct and avoid unnecessary complexity.</p><p>Initial conversations are confidential and focused on what support you need now.</p><div class="details"><div><b>Office hours</b><span>Monday–Friday, 09:00–17:30</span></div><div><b>Email</b><span>office@__DOMAIN__</span></div></div></div></section>
  </main>
  <footer><div class="wrap footer"><strong>Alder &amp; Finch Accountants</strong><span>__DOMAIN__ · Privacy notice · Terms of business</span></div></footer>
</body>
</html>
