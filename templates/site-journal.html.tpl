<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Riverside Library — books, digital resources, local events and study spaces.">
  <title>Riverside Library</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <style>
    :root{color-scheme:light;--ink:#243329;--green:#276447;--light:#f3f6f1;--warm:#f0e4cf;--line:#d5ddd4;--muted:#607068}
    *{box-sizing:border-box}body{margin:0;background:#fff;color:var(--ink);font:16px/1.55 Arial,Helvetica,sans-serif}a{color:inherit}.wrap{width:min(1120px,calc(100% - 40px));margin:auto}
    .notice{padding:9px 0;background:var(--warm);font-size:.84rem}.notice .wrap{display:flex;justify-content:space-between;gap:20px}.notice a{font-weight:700}
    header{border-bottom:1px solid var(--line)}.header{height:78px;display:flex;align-items:center;justify-content:space-between}.brand{text-decoration:none;font:700 1.25rem Georgia,serif}.brand small{display:block;color:var(--green);font:600 .68rem Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}
    nav{display:flex;gap:26px;font-size:.9rem}nav a{text-decoration:none}nav a:hover{color:var(--green)}.hero{padding:56px 0;background:var(--light);border-bottom:1px solid var(--line)}
    .hero-grid{display:grid;grid-template-columns:1fr 350px;gap:70px;align-items:center}h1{margin:0 0 14px;font:700 clamp(2.4rem,5vw,4.2rem)/1.05 Georgia,serif}.hero p{max-width:650px;margin:0 0 26px;color:var(--muted);font-size:1.08rem}
    .search{display:flex;max-width:680px}.search input{min-width:0;flex:1;padding:14px 16px;border:1px solid #aebcaf;border-right:0;border-radius:5px 0 0 5px;background:#fff;font:inherit}.search button{padding:0 22px;border:0;border-radius:0 5px 5px 0;background:var(--green);color:#fff;font-weight:700}
    .hours{padding:24px;border-radius:7px;background:#fff;border:1px solid var(--line)}.hours h2{margin:0 0 12px;font-size:1.05rem}.hours div{display:flex;justify-content:space-between;padding:7px 0;border-top:1px solid var(--line);font-size:.9rem}.hours b{color:var(--green)}
    .section{padding:62px 0}.section h2{margin:0 0 25px;font:700 1.8rem Georgia,serif}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{padding:24px;border:1px solid var(--line);border-radius:6px}.card .date{color:var(--green);font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.card h3{margin:12px 0 8px;font-size:1.08rem}.card p{margin:0 0 15px;color:var(--muted);font-size:.91rem}.card a{color:var(--green);font-weight:700;font-size:.88rem}
    .links{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;border:1px solid var(--line);background:var(--line)}.link{padding:24px;background:#fff;text-decoration:none}.link b{display:block;margin-bottom:6px}.link span{color:var(--muted);font-size:.85rem}
    footer{padding:36px 0;background:var(--ink);color:#dfe8e1;font-size:.84rem}.footer{display:flex;justify-content:space-between;gap:30px}.footer b{display:block;color:#fff;margin-bottom:5px}
    @media(max-width:760px){.notice .wrap span:last-child{display:none}.header{height:66px}nav a:not(:last-child){display:none}.hero-grid{grid-template-columns:1fr;gap:32px}.cards,.links{grid-template-columns:1fr}.section{padding:45px 0}.footer{display:block}.footer div+div{margin-top:20px}}
  </style>
</head>
<body>
  <div class="notice"><div class="wrap"><span>Library services are operating as usual today.</span><span><a href="#hours">View opening hours</a></span></div></div>
  <header><div class="wrap header"><a class="brand" href="/">Riverside Library<small>Books · learning · community</small></a><nav><a href="#events">Events</a><a href="#services">Services</a><a href="#hours">Visit</a><a href="mailto:library@__DOMAIN__">Contact</a></nav></div></header>
  <main>
    <section class="hero"><div class="wrap hero-grid"><div><h1>Find your next book, idea or quiet place.</h1><p>Explore the catalogue, use our digital collection or join a programme at your local library.</p><form class="search" action="/" method="get"><input name="q" aria-label="Search the catalogue" placeholder="Search books, authors and subjects"><button type="submit">Search</button></form></div><aside class="hours" id="hours"><h2>Today's hours</h2><div><span>Main library</span><b>09:00–19:00</b></div><div><span>Study room</span><b>09:00–18:30</b></div><div><span>Help desk</span><b>10:00–17:00</b></div></aside></div></section>
    <section class="wrap section" id="events"><h2>Coming up at the library</h2><div class="cards"><article class="card"><span class="date">Tuesday · 18:00</span><h3>Local history evening</h3><p>An informal introduction to maps, photographs and records in the town archive.</p><a href="mailto:library@__DOMAIN__">Ask about places</a></article><article class="card"><span class="date">Thursday · 10:30</span><h3>Story time for families</h3><p>Stories, songs and simple activities for young children and their carers.</p><a href="mailto:library@__DOMAIN__">Event details</a></article><article class="card"><span class="date">Saturday · 11:00</span><h3>Digital help drop-in</h3><p>Bring a phone, tablet or laptop and get help with everyday online tasks.</p><a href="mailto:library@__DOMAIN__">Find out more</a></article></div></section>
    <section class="wrap section" id="services"><h2>Popular services</h2><div class="links"><a class="link" href="/"><b>Online catalogue</b><span>Search and reserve items</span></a><a class="link" href="/"><b>Digital library</b><span>E-books and audiobooks</span></a><a class="link" href="/"><b>Study spaces</b><span>Desks and quiet rooms</span></a><a class="link" href="/"><b>Local archive</b><span>Records and photographs</span></a></div></section>
  </main>
  <footer><div class="wrap footer"><div><b>Riverside Library</b><span>Open throughout the week for reading, research and community activities.</span></div><div><b>Contact</b><span>library@__DOMAIN__ · __DOMAIN__</span></div></div></footer>
</body>
</html>
