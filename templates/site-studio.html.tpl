<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Plainform is an independent design studio working across identity, digital products and print.">
  <title>Plainform Studio</title>
  <style>
    :root{color-scheme:light;--black:#101010;--white:#f7f7f4;--blue:#3157ff;--muted:#6d6d68}
    *{box-sizing:border-box}body{margin:0;background:var(--white);color:var(--black);font:16px/1.45 Arial,Helvetica,sans-serif}a{color:inherit;text-decoration:none}
    header,main,footer{width:min(1240px,calc(100% - 48px));margin:auto}header{height:84px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #cfcfca}
    .logo{font-size:1.05rem;font-weight:700;letter-spacing:-.03em}.logo i{display:inline-block;width:11px;height:11px;margin-right:9px;background:var(--blue);border-radius:50%}
    nav{display:flex;gap:28px;font-size:.9rem}nav a:hover{color:var(--blue)}.hero{padding:88px 0 108px}.eyebrow{color:var(--blue);font-weight:700;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase}
    h1{max-width:1040px;margin:24px 0 0;font-size:clamp(3.3rem,8vw,7.8rem);line-height:.92;letter-spacing:-.07em;font-weight:600}
    .work{display:grid;grid-template-columns:1.2fr .8fr;gap:18px;padding-bottom:18px}.card{min-height:360px;padding:30px;display:flex;flex-direction:column;justify-content:space-between;background:#dfdfda}
    .card:nth-child(2){background:var(--blue);color:#fff}.card:nth-child(3){background:#171717;color:#fff}.card:nth-child(4){background:#e6e0cf}
    .label{display:flex;justify-content:space-between;font-size:.8rem;text-transform:uppercase;letter-spacing:.08em}.card h2{max-width:560px;margin:0;font-size:clamp(2rem,4vw,4rem);line-height:.98;letter-spacing:-.045em;font-weight:500}
    .profile{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;padding:100px 0}.profile h3{margin:0;font-size:.85rem;text-transform:uppercase;letter-spacing:.12em}.profile p{margin:0;font-size:clamp(1.5rem,3vw,2.8rem);line-height:1.16;letter-spacing:-.035em}
    footer{display:flex;justify-content:space-between;padding:30px 0 45px;border-top:1px solid #cfcfca;color:var(--muted);font-size:.8rem}
    @media(min-width:820px){.card:nth-child(3),.card:nth-child(4){min-height:290px}.work{grid-template-columns:1.2fr .8fr}.card:nth-child(3){grid-column:1}.card:nth-child(4){grid-column:2}}
    @media(max-width:720px){header{width:calc(100% - 32px)}header,main,footer{width:calc(100% - 32px)}nav a:not(:last-child){display:none}.hero{padding:64px 0 76px}.work,.profile{grid-template-columns:1fr}.profile{gap:32px;padding:70px 0}.card{min-height:280px}footer{display:block}footer span{display:block;margin-top:8px}}
  </style>
</head>
<body>
  <header><a class="logo" href="/"><i></i>Plainform</a><nav><a href="#work">Work</a><a href="#studio">Studio</a><a href="mailto:hello@__DOMAIN__">Contact</a></nav></header>
  <main>
    <section class="hero"><div class="eyebrow">Independent design practice</div><h1>Clear ideas, made tangible.</h1></section>
    <section class="work" id="work">
      <article class="card"><div class="label"><span>Wayfinding</span><span>2026</span></div><h2>A civic identity designed for everyday use.</h2></article>
      <article class="card"><div class="label"><span>Digital product</span><span>2025</span></div><h2>Making complex information feel calm.</h2></article>
      <article class="card"><div class="label"><span>Publishing</span><span>2025</span></div><h2>A flexible system for small editions.</h2></article>
      <article class="card"><div class="label"><span>Research</span><span>Ongoing</span></div><h2>Notes on signs, tools and public space.</h2></article>
    </section>
    <section class="profile" id="studio"><h3>Studio</h3><p>Plainform works with thoughtful organisations on identities, interfaces and printed matter. Our approach is direct, collaborative and built to last.</p></section>
  </main>
  <footer><span>Plainform Studio · 2026</span><span>__DOMAIN__</span></footer>
</body>
</html>
